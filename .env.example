# Anthropic API key. BRICKHOUSE_ANTHROPIC_API_KEY is used first; ANTHROPIC_API_KEY also works.
BRICKHOUSE_ANTHROPIC_API_KEY=
# Only for an organization-scoped key: the workspace to bill (wrkspc_...), sent as anthropic-workspace-id
# BRICKHOUSE_ANTHROPIC_WORKSPACE_ID=
# Street photos for the address lookup (free: mapillary.com/dashboard/developers, client token)
MAPILLARY_TOKEN=
# Contact for the OpenStreetMap geocoder's User-Agent, e.g. an email or site (their usage policy asks for one)
# BRICKHOUSE_CONTACT=
# BRICKHOUSE_MODEL=claude-opus-5-5
# BRICKHOUSE_EFFORT=high        # low | medium | high | xhigh | max
# PORT=5173
